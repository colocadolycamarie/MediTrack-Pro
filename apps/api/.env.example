# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meditrack

# Port the API server listens on (optional, defaults to 4000)
PORT=4000

# development | production (optional, defaults to development when unset)
NODE_ENV=development

# URL of the deployed frontend, used to restrict CORS when the frontend and
# backend are hosted separately (e.g. this API on Render, frontend on
# Vercel). Optional — when unset, CORS allows any origin.
# FRONTEND_URL=https://your-app.vercel.app
