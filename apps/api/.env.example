# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dosemate

# Port the API server listens on (optional, defaults to 4000)
PORT=4000

# development | production (optional, defaults to development when unset)
NODE_ENV=development

# URL of the deployed frontend, used to restrict CORS when the frontend and
# backend are hosted separately (e.g. this API on Render, frontend on
# Vercel). Optional — when unset, CORS allows any origin.
# FRONTEND_URL=https://your-app.vercel.app

# Time zone used to read dosing times like "08:00" (IANA name). Cloud hosts run
# in UTC, so set this or 8:00 AM will fire at 8:00 UTC. Optional — when unset,
# the server's own time zone is used (the previous behaviour).
# APP_TIMEZONE=Asia/Manila

# How long a login lasts, in hours (optional, defaults to 168 = 7 days).
# SESSION_TTL_HOURS=168

# Number of reverse proxies in front of the API (optional). Defaults to 1 in
# production so rate limiting sees the real client IP; set 0 if there is no proxy.
# TRUST_PROXY=1
