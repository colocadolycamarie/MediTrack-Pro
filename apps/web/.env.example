# Port the Vite dev server listens on (optional, defaults to 5173)
PORT=5173

# Port of the local API server, used by the dev proxy for /api requests
# (optional, defaults to 4000 — see apps/api/.env.example)
API_PORT=4000

# Base URL of the deployed API, used when the frontend and backend are
# hosted separately (e.g. this app on Vercel, the API on Render).
# Leave unset for local dev and for single-process deployments where the
# API serves this app's build output itself — requests stay relative to
# the current origin in that case.
# VITE_API_URL=https://your-api.onrender.com
